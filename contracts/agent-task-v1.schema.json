{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYBCORE Agent Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task_id",
    "issuer",
    "assignee",
    "capability",
    "input",
    "budget"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "assignee": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "string"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_runtime_ms",
        "max_output_bytes"
      ],
      "properties": {
        "max_runtime_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
